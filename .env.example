# 서버
ADMIN_KEY=admin1234
EDGE_KEY=edge1234
DATA_DIR=./data
LIVE_SECONDS=30
CHAT_MAX_MINUTES=15
SNAPSHOT_INTERVAL=10

# AI — API 키는 관리자 콘솔(/admin → AI 설정)에서 입력합니다. 콘솔 값이 아래보다 우선하며, 둘 다 없으면 Mock 대화로 동작합니다.
# ANTHROPIC_API_KEY=sk-ant-...   (콘솔 대신 파일로 두고 싶을 때만)
LLM_PROVIDER=auto        # auto | anthropic | mock
LLM_MODEL=claude-opus-5
TTS_PROVIDER=auto        # auto | elevenlabs | browser (관리자 콘솔에서도 변경 가능)

# 현장 프로그램
SERVER_URL=http://127.0.0.1:8765
CAMERA_INDEX=0
CAPTURE_WIDTH=1920
CAPTURE_HEIGHT=1080
LIVE_FPS=5
